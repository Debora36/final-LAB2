@model final_LAB2.Models.Usuario
@{
    ViewData["Title"] = ViewBag.DesdePerfil == true ? "Mi Perfil" : "Editar Usuario";
    bool desdePerfil = ViewBag.DesdePerfil == true;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 col-lg-6 mx-auto">
            <div class="card border-0">
                <div class="card-header bg-white">
                    <h3 class="card-title mb-0">
                        @(desdePerfil ? "Mi Perfil" : "Editar Usuario")
                    </h3>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Activo" />

                        <!-- Foto de perfil -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Foto de perfil</label>
                            <div class="d-flex align-items-center gap-4">
                                <img id="previewAvatar"
                                     src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? "/img/avatar-default.svg" : Model.AvatarUrl)"
                                     alt="Avatar"
                                     class="rounded-circle"
                                     style="width: 90px; height: 90px; object-fit: cover; border: 3px solid #dee2e6;" />
                                <div class="flex-grow-1">
                                    <div class="d-flex gap-2 mb-2">
                                        <input type="file" id="archivoAvatar" name="archivoAvatar" class="form-control mb-2" accept=".jpg,.jpeg,.png,.gif" />
                                    </div>
                                    <small class="text-muted">JPG, PNG o GIF. Máximo 2MB.</small>
                                </div>
                            </div>
                            <input type="hidden" asp-for="AvatarUrl" />
                        </div>

                        <hr class="my-3" />

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label"></label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        @if (desdePerfil)
                        {
                            <!-- Usuario viendo su propio perfil — rol solo lectura -->
                            <input type="hidden" asp-for="Rol" />
                            <div class="mb-3">
                                <label class="form-label">Rol</label>
                                <input type="text" class="form-control" value="@Model.Rol" disabled />
                            </div>
                        }
                        else
                        {
                            <!-- Admin editando — puede cambiar el rol -->
                            <div class="mb-3">
                                <label asp-for="Rol" class="form-label"></label>
                                <select asp-for="Rol" class="form-select">
                                    <option value="Admin">Admin</option>
                                    <option value="Tecnico">Técnico</option>
                                    <option value="Empleado">Empleado</option>
                                </select>
                                <span asp-validation-for="Rol" class="text-danger"></span>
                            </div>
                        }
                        @if (desdePerfil)
                        {
                        <hr class="my-4" />
                        <h6 class="text-muted mb-3">Cambiar contraseña <span class="fw-normal">(opcional)</span></h6>

                        <div class="mb-3">
                            <label for="nuevaPassword" class="form-label">Nueva contraseña</label>
                            <input type="password" id="nuevaPassword" name="nuevaPassword" class="form-control"
                                   placeholder="Dejar vacío para no cambiarla" minlength="6" />
                        </div>

                        <div class="mb-3">
                            <label for="confirmarPassword" class="form-label">Confirmar nueva contraseña</label>
                            <input type="password" id="confirmarPassword" name="confirmarPassword"
                                   class="form-control" minlength="6" />
                            <span class="text-danger" id="passwordError"></span>
                        </div>
                        }
                        <div class="d-flex justify-content-between mt-4">
                            @if (desdePerfil)
                            {
                                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left me-1"></i>Cancelar
                                </a>
                            }
                            else
                            {
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left me-1"></i>Cancelar
                                </a>
                            }
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>Guardar cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('form').addEventListener('submit', function (e) {
            const nuevaPassword = document.getElementById('nuevaPassword').value;
            const confirmarPassword = document.getElementById('confirmarPassword').value;
            const errorSpan = document.getElementById('passwordError');

            if (nuevaPassword && nuevaPassword !== confirmarPassword) {
                e.preventDefault();
                errorSpan.textContent = 'Las contraseñas no coinciden.';
            } else {
                errorSpan.textContent = '';
            }
        });
        document.getElementById('archivoAvatar').addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('previewAvatar').src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}