@model final_LAB2.Models.Equipo
@{
    ViewData["Title"] = "Crear Equipo";
    var categoriasElegibles = ViewBag.Categorias as List<final_LAB2.Models.Categoria> ?? new();
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 col-lg-6 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-laptop me-2"></i>Crear Equipo
                    </h3>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- enctype="multipart/form-data" es obligatorio para que el archivo viaje al servidor -->
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Modelo" class="form-label"></label>
                                    <input asp-for="Modelo" class="form-control" />
                                    <span asp-validation-for="Modelo" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="NumeroSerie" class="form-label"></label>
                                    <input asp-for="NumeroSerie" class="form-control" />
                                    <span asp-validation-for="NumeroSerie" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoriaId" class="form-label">Categoría a la que pertenece</label>
                            <select asp-for="CategoriaId" class="form-select">
                                <option value="">Seleccione una categoría</option>
                                @foreach (var categoria in categoriasElegibles)
                                {
                                    <option value="@categoria.Id">@categoria.Nombre</option>
                                }
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="archivoGarantia" class="form-label">Factura o garantía (opcional)</label>
                            <input type="file" id="archivoGarantia" name="archivoGarantia" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                            <small class="text-muted">PDF o imagen del comprobante.</small>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>Crear Equipo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
