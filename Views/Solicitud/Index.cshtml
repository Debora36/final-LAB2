@model final_LAB2.Models.ViewModels.PaginatedListViewModel<final_LAB2.Models.ViewModels.SolicitudViewModel>
@{
    ViewData["Title"] = "Gestión de Solicitudes";
    string? estadoActual = ViewBag.EstadoActual;
}

<div class="container-fluid">
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-times-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card border-0">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h3 class="card-title mb-0 fw-bold text-primary">
                        <i class="bi bi-envelope-paper-fill me-2"></i>Lista de Solicitudes
                    </h3>
                    @if (User.IsInRole("Empleado"))
                    {
                        <a class="btn btn-primary" asp-action="Create">
                            <i class="fas fa-plus me-1"></i>Nueva solicitud
                        </a>
                    }
                </div>
                <div class="card-body">

                    <!-- Filtros por estado -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="btn-group" role="group">
                                <a asp-action="Index"
                                   class="btn btn-sm @(estadoActual == null ? "btn-secondary" : "btn-outline-secondary")">
                                    Todos
                                </a>
                                <a asp-action="Index" asp-route-estado="Pendiente"
                                   class="btn btn-sm @(estadoActual == "Pendiente" ? "btn-warning" : "btn-outline-warning")">
                                    Pendiente
                                </a>
                                <a asp-action="Index" asp-route-estado="Aprobada"
                                   class="btn btn-sm @(estadoActual == "Aprobada" ? "btn-success" : "btn-outline-success")">
                                    Aprobada
                                </a>
                                <a asp-action="Index" asp-route-estado="Rechazada"
                                   class="btn btn-sm @(estadoActual == "Rechazada" ? "btn-danger" : "btn-outline-danger")">
                                    Rechazada
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Contador -->
                    @if (Model.TotalCount > 0)
                    {
                        <p class="text-muted mb-3">
                            Mostrando <strong>@((Model.PageIndex - 1) * Model.PageSize + 1)</strong> a
                            <strong>@Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount)</strong> de
                            <strong>@Model.TotalCount</strong> solicitudes
                        </p>
                    }

                    <!-- Tabla -->
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Empleado</th>
                                    <th>Categoría</th>
                                    <th>Motivo</th>
                                    <th>Tiempo Necesario</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Items.Any())
                                {
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td><span class="badge bg-info">@item.Solicitud.Id</span></td>
                                            <td><strong>@item.Empleado.Nombre @item.Empleado.Apellido</strong></td>
                                            <td>@item.Categoria.Nombre</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.Solicitud.Motivo))
                                                {
                                                    <span title="@item.Solicitud.Motivo">
                                                        @(item.Solicitud.Motivo.Length > 40
                                                            ? item.Solicitud.Motivo.Substring(0, 40) + "…"
                                                            : item.Solicitud.Motivo)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic">Sin motivo</span>
                                                }
                                            </td>
                                            <td>@item.Solicitud.TiempoNecesario</td>
                                            <td>@item.Solicitud.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @{
                                                    var claseBadge = item.Solicitud.Estado switch
                                                    {
                                                        "Pendiente"  => "bg-warning text-dark",
                                                        "Aprobada"   => "bg-success",
                                                        "Rechazada"  => "bg-danger",
                                                        _            => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @claseBadge">@item.Solicitud.Estado</span>
                                            </td>
                                            <td class="text-center">

                                            @if (User.IsInRole("Empleado") && item.Solicitud.Estado == "Pendiente")
                                            {
                                                <a class="btn btn-sm btn-outline-warning"
                                                asp-action="Editar" asp-route-id="@item.Solicitud.Id">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form asp-action="Eliminar" asp-route-id="@item.Solicitud.Id"
                                                    method="post" class="d-inline"
                                                    onsubmit="return confirm('¿Eliminar esta solicitud?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            }

                                            @if (User.IsInRole("Admin") || User.IsInRole("Tecnico"))
                                            {
                                                @if (item.Solicitud.Estado == "Pendiente")
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-success"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#modalAprobar-@item.Solicitud.Id"
                                                            data-categoria="@item.Solicitud.CategoriaId"
                                                            title="Aprobar">
                                                        <i class="fas fa-check"></i>
                                                    </button>

                                                    <form asp-action="CambiarEstado" asp-route-id="@item.Solicitud.Id"
                                                        method="post" class="d-inline"
                                                        onsubmit="return confirm('¿Rechazar esta solicitud?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="nuevoEstado" value="Rechazada" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Rechazar">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </form>
                                                }
                                            }
                                        </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">
                                            No hay solicitudes que coincidan con el filtro
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Paginación -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Navegación de páginas">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-pageIndex="@(Model.PageIndex - 1)"
                                       asp-route-estado="@estadoActual">
                                        <i class="fas fa-angle-left"></i> Anterior
                                    </a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                        <a class="page-link" asp-action="Index"
                                           asp-route-pageIndex="@i"
                                           asp-route-estado="@estadoActual">@i</a>
                                    </li>
                                }
                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-pageIndex="@(Model.PageIndex + 1)"
                                       asp-route-estado="@estadoActual">
                                        Siguiente <i class="fas fa-angle-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }

                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Aprobar — uno por solicitud -->
@foreach (var item in Model.Items)
{
    @if (item.Solicitud.Estado == "Pendiente" && (User.IsInRole("Admin") || User.IsInRole("Tecnico")))
    {
        <div class="modal fade" id="modalAprobar-@item.Solicitud.Id" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fas fa-check me-2"></i>Aprobar Solicitud #@item.Solicitud.Id
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form asp-controller="Prestamo" asp-action="Aprobar" asp-route-id="@item.Solicitud.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-body">
                            <p class="text-muted mb-3">
                                Empleado: <strong>@item.Empleado.Nombre @item.Empleado.Apellido</strong><br/>
                                Categoría: <strong>@item.Categoria.Nombre</strong><br/>
                                Tiempo solicitado: <strong>@item.Solicitud.TiempoNecesario</strong>
                            </p>

                            <div class="mb-3">
                                <label class="form-label">Equipo a prestar</label>
                                <select name="equipoId" 
                                        class="modern-select2 equipo-select-ajax w-100" 
                                        data-categoria="@item.Solicitud.CategoriaId"
                                        required>
                                    <option value="">Buscar equipo...</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Fecha de devolución estimada</label>
                                <input type="date" name="fechaDevolucionEstimada" class="form-control"
                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-check me-1"></i>Aprobar y crear préstamo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    @if (TempData["AbrirModal"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                new bootstrap.Modal(document.getElementById('modalCrearSolicitud')).show();
            });
        </script>
    }

    <script>
        document.addEventListener('show.bs.modal', function (event) {
            const modal = event.target;
            console.log('modal id:', modal.id);

            if (!modal.id.startsWith('modalAprobar')) return;

            const boton = event.relatedTarget;
            if (!boton) return;

            const categoriaId = boton.dataset.categoria;
            const select = modal.querySelector('.equipo-select-ajax');

            if (!select) return;

            if ($(select).data('select2')) {
                $(select).select2('destroy');
            }

            $(select).select2({
            dropdownParent: $(modal),
            placeholder: 'Buscar equipo por modelo o número de serie...',
            minimumInputLength: 0,
            language: {
                inputTooShort: () => 'Escribí para buscar...',
                noResults: () => 'No hay equipos disponibles para esta categoría',
                searching: () => 'Buscando...'
            },
            ajax: {
                url: '/Equipo/BuscarDisponibles',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        q: params.term,
                        categoriaId: categoriaId
                    };
                },
                processResults: function (data) {
                    return { results: data.results ?? [] };
                },
                error: function () {
                    const contenedor = modal.querySelector('.sin-equipos');
                    if (contenedor) contenedor.remove();
                    select.insertAdjacentHTML('afterend',
                        '<small class="text-danger sin-equipos">Error al buscar equipos. Intentá de nuevo.</small>');
                }
            }
        });
        });
    </script>
}